APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8500

DB_USERNAME=input
DB_PASSWORD=password
DB_DATABASE=input

QUEUE_CONNECTION=sync
FILESYSTEM_DRIVER=local

# Optional S3 storage with rustfs: set FILESYSTEM_DRIVER=minio above and
# uncomment these lines. Create the bucket "input" first in the rustfs
# console at http://localhost:8502 (login: sail / password).
# COMPOSE_PROFILES=s3
# MINIO_ENDPOINT=http://rustfs:9000
# MINIO_BUCKET=input
# MINIO_ACCESS_KEY_ID=sail
# MINIO_SECRET_ACCESS_KEY=password

# Development Config
APP_PORT=8500
FORWARD_RUSTFS_PORT=8501
FORWARD_RUSTFS_CONSOLE_PORT=8502
FORWARD_REDIS_PORT=8503
FORWARD_DB_PORT=8504
FORWARD_MAILHOG_DASHBOARD_PORT=8505
