# Browser tests (Laravel Dusk), see "Browser tests" in README.md.
# `sail dusk` swaps .env for .env.dusk.local while the tests run.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://laravel.test

# Serves Dusk's login route, which signs in as any user. Only for browser test runs.
DUSK_ENABLED=true

# Its own SQLite file, so the tests never touch the MariaDB databases
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

SESSION_DRIVER=file
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DRIVER=local
TELESCOPE_ENABLED=false
